APP_NAME="CalTrack AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=caltrack
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=public

# AI Vision API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Apple In-App Purchase & Server Notifications
APPLE_BUNDLE_ID=com.vin.calorielq
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=Sandbox


# Sign in with Apple: comma-separated audiences (iOS bundle ID, optional Services ID)
APPLE_CLIENT_IDS=com.vin.calorielq

# Google Sign-In: comma-separated OAuth client IDs (web client ID is the one the
# native SDK signs tokens for; add iOS/Android client IDs if needed)
GOOGLE_CLIENT_IDS=
