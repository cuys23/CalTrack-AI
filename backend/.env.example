APP_NAME="CalTrack AI"
APP_ENV=local
APP_KEY=
# Never true on a deployed server: debug pages disclose stack traces,
# configuration, and database structure to anyone who triggers an error.
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=caltrack
DB_USERNAME=postgres
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=public

# AI Vision API Keys. While both are empty the service returns hardcoded sample
# data instead of analysing anything, so production must set at least one.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ceiling on paid vision calls per account per day. 0 disables the cap.
AI_VISION_DAILY_SCAN_LIMIT=50

# Apple In-App Purchase & Server Notifications
APPLE_BUNDLE_ID=com.vin.calorielq
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_ENVIRONMENT=Sandbox

# Sign in with Apple. Every client that may present a token must be listed here,
# comma separated: a token whose audience is absent is refused.
APPLE_AUDIENCES=com.vin.calorielq

# Google Sign-In. OAuth client IDs from the Google Cloud console, comma
# separated. iOS and Android each have their own and both belong here.
# Google sign-in is refused entirely while this is empty.
GOOGLE_OAUTH_CLIENT_IDS=

# Browser origins allowed to call the API, comma separated. Empty means none,
# which is correct for a deployment serving only the native app.
CORS_ALLOWED_ORIGINS=

# Shown on the legal pages and submitted to App Store Connect as the support
# contact. App Review does check that it is reachable.
SUPPORT_EMAIL=support@caltrack.ai

# Operator dashboard at /admin. It exposes every user record, subscription, and
# revenue figure. Leaving either value empty locks the dashboard rather than
# opening it.
ADMIN_USERNAME=
ADMIN_PASSWORD=

