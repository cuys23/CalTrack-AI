# Production environment template.
#
# Copy to .env on the server and fill in. Never commit the filled-in copy: it is
# excluded from the Docker image by .dockerignore precisely so credentials do
# not travel inside a pushed image.

APP_NAME="CalTrack AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.caltrack.ai

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Hostnames are compose service names, not localhost: each service is its own
# container.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=caltrack
DB_USERNAME=caltrack
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

FILESYSTEM_DISK=public

# At least one is required. While both are empty every scan returns hardcoded
# sample data instead of analysing the photograph.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ceiling on paid vision calls per account per day. 0 disables the cap.
AI_VISION_DAILY_SCAN_LIMIT=50

# Sign in with Apple: every client that may present a token, comma separated.
APPLE_AUDIENCES=com.vin.calorielq
APPLE_BUNDLE_ID=com.vin.calorielq
APPLE_ENVIRONMENT=Production

# Google Sign-In: OAuth client IDs from the Google Cloud console, comma
# separated. Google sign-in is refused entirely while this is empty.
GOOGLE_OAUTH_CLIENT_IDS=

# Browser origins allowed to call the API. Empty is correct when only the
# native app calls it.
CORS_ALLOWED_ORIGINS=

SUPPORT_EMAIL=support@caltrack.ai

# Operator dashboard at /admin. Empty values lock the dashboard rather than
# opening it.
ADMIN_USERNAME=
ADMIN_PASSWORD=
