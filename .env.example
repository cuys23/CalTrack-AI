# CalTrack AI Mobile App Environment Variables
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_APP_ENV=development

# RevenueCat / Apple StoreKit Public Key (If using RevenueCat)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxx

# AI Vision Direct Key (Optional local testing)
EXPO_PUBLIC_GEMINI_API_KEY=

# Google Sign-In: OAuth client ID of type "Web" from Google Cloud Console
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
