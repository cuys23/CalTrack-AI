# CalTrack AI Mobile App Environment Variables
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_APP_ENV=development

# Google Sign-In. OAuth client IDs from the Google Cloud console. The iOS one is
# required; the web one is needed only if the backend ever exchanges auth codes.
# The reversed iOS client ID also belongs in app.json under the
# @react-native-google-signin plugin's iosUrlScheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
